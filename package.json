{
  "name": "gdatavaas",
  "description": "This app aims to provide an additional layer of security to your Nextcloud instance by enabling automatic and manual scanning of files for malicious content.",
  "version": "0.0.8",
  "author": "G DATA CyberDefense AG",
  "contributors": [],
  "bugs": {
    "url": "https://github.com/GDATASoftwareAG/nextcloud-gdata-antivirus/issues"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "webpack --node-env production",
    "dev": "webpack --node-env development --progress",
    "watch": "webpack --node-env development --progress --watch",
    "serve": "webpack --node-env development serve --progress",
    "lint": "stylelint css/*.css css/*.scss src/**/*.scss src/**/*.vue",
    "lint:fix": "stylelint css/*.css css/*.scss src/**/*.scss src/**/*.vue --fix"
  },
  "dependencies": {
    "@mdi/svg": "7.4.47",
    "@nextcloud/auth": "2.6.0",
    "@nextcloud/dialogs": "8.0.0",
    "@nextcloud/files": "4.1.1",
    "@nextcloud/router": "3.2.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=7.0.0"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "2.0.0",
    "@nextcloud/browserslist-config": "3.1.2",
    "@nextcloud/eslint-config": "9.0.1",
    "@nextcloud/stylelint-config": "3.2.2",
    "@nextcloud/webpack-vue-config": "7.1.0",
    "@babel/core": "8.0.10",
    "eslint": "10.14.0",
    "stylelint": "17.16.0"
  },
  "allowScripts": {
    "@nextcloud/webpack-vue-config@7.1.0": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.51.0": true
  }
}
